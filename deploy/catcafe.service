[Unit]
Description=Cat Cafe
Documentation=https://github.com/danngreen/catcafe
# The server binds every interface, so it does not need to wait for a
# particular address to come up. network.target is enough.
After=network.target
# These two belong in [Unit], not [Service] — systemd will tell you the key is
# unknown rather than that it is in the wrong section. Keep trying rather than
# giving up after the default five attempts in ten seconds: a box in the house
# that retries a bad deploy beats one found quietly dead a week later.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/catcafe

# Both lines below name the same Node on purpose: the check is only worth
# anything if it runs on the interpreter the server is about to use.
#
# This is nvm's copy, not /usr/bin/node. On orangepi4a /usr/bin/node is 12.22.9,
# which cannot run this server at all — the distro package is years behind and
# systemd does not read your shell profile, so it never sees the nvm one unless
# you spell it out. Find the right path with:
#
#   ssh orangepi@… 'readlink -f "$(source ~/.nvm/nvm.sh; nvm which default)"'
#
# and note that it has the version number in it: upgrading Node through nvm
# moves the binary and both of these lines have to move with it. The failure if
# you forget is `status=203/EXEC`, which does not mention Node at all.
ExecStartPre=/home/orangepi/.nvm/versions/node/v24.18.0/bin/node /home/orangepi/catcafe/tools/preflight.cjs
ExecStart=/home/orangepi/.nvm/versions/node/v24.18.0/bin/node /home/orangepi/catcafe/server.js

# The port to serve on, and where the valleys are kept. SESSION_SAVE may be an
# absolute path or one relative to the repository; leave it unset for
# `<repo>/saves`. Never set it to 0 here — that plays without saving anything,
# which is what the test harness wants and the opposite of what a house server
# wants.
Environment=PORT=8080
# Environment=SESSION_SAVE=/home/orangepi/catcafe/saves

# `on-failure` would not bring it back from a clean exit, and this server exits
# 0 on SIGTERM — it catches the signal to write the valleys out before it goes.
# For something meant to stay up, always is the honest setting.
#
# It is also how deploy/push.sh restarts the game without being root. The
# service runs as orangepi, so an ssh session as orangepi may signal it; the
# server saves and exits 0, and this line brings it straight back on the new
# code. If you ever change Restart=, push.sh stops working and the failure is
# a server that went away and did not come back.
Restart=always
RestartSec=5

# Stopping is a save. persist() is synchronous — write to a temp file, rename
# over the real one — so the handler finishes well inside this.
KillSignal=SIGTERM
TimeoutStopSec=20

SyslogIdentifier=catcafe

# Modest hardening. Note what is NOT here: ProtectHome, which every hardening
# guide suggests and which would hide /home/orangepi from the service and stop
# it finding its own code.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
