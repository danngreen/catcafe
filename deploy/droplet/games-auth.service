[Unit]
Description=Sign-in check for the public games (Caddy forward_auth)
After=network.target
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
User=games
Group=games
# Its own copy, outside the game's directory, so a game deploy can never leave
# the wall half-updated. setup.sh puts it here.
ExecStart=/usr/bin/node /usr/local/lib/games-auth/auth.js
# The secret, the password hash and the invite key. Root-only; systemd reads it
# before dropping to the games user.
EnvironmentFile=/etc/games-auth.env

Restart=always
RestartSec=2
SyslogIdentifier=games-auth

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
