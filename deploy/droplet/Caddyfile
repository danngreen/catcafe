# Caddy on the public games server.
#
# setup.sh writes this to /etc/caddy/Caddyfile with your own names in place of
# catcafe.example.com and you@example.com. Caddy gets and renews the HTTPS
# certificates itself; the email is only for Let's Encrypt to write to if one
# is about to expire and can't be renewed.
#
# A game can sit behind the family's wall (`gated`): /login and /logout go to
# the sign-in service, and everything else is let through only if that service
# says the visitor has signed in. WebSockets go through the same check and then
# the game's /ws is proxied as normal.
#
# Or it can be open to everyone (`open`), which is how the public Cat Cafe runs
# (setup.sh --public): its invite codes are the way into a valley, and the game
# server keeps its own limits on top.

{
	email you@example.com
}

(gated) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# Signing in, renewing and signing out are the only things reachable
	# without the cookie.
	handle /login* {
		reverse_proxy 127.0.0.1:9000
	}
	handle /logout {
		reverse_proxy 127.0.0.1:9000
	}
	handle {
		forward_auth 127.0.0.1:9000 {
			uri /check
		}
		reverse_proxy {args[0]}
	}
}

# The open kind: no sign-in, the same headers.
(open) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy {args[0]}
}

# setup.sh --public changes `gated` to `open` here, and adds a redirect block
# below for each name given with --redirect.
catcafe.example.com {
	import gated 127.0.0.1:8080
}

# The next game is one more block, on its own subdomain and its own port. Use
# a subdomain rather than a path: the games ask for /ws, /games and so on from
# the root of the site, and would miss under /othergame/.
#
# othergame.example.com {
# 	import gated 127.0.0.1:8082
# }
